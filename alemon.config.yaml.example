# 云端分离版示例。复制为 alemon.config.yaml 前，先核对云数据库地址并填入服务器现有凭据。
# 这个文件只给 server 使用；不要把含真实密码、令牌的配置提交到 Git。
mysql:
  host: 172.16.255.14
  port: 3306
  user: root
  password: replace-with-cloud-db-password
  database: fantasy_final
redis:
  host: 127.0.0.1
  port: 6379
  user: root
  db: 6

login: "server"
port: 17117

FantasyFinal:
  runtime: core
  appApiServer:
    enabled: true
    listenHost: "127.0.0.1"
    port: 17119
  automatonPortrait:
    host:
      provider: generic
      uploadUrl: "https://img.czl.net/api/v1/upload"
      # 复制原服务器配置中的 API Token，不加 Bearer 前缀。
      token: "replace-with-existing-image-host-token"
  adminWeb:
    enabled: true
    listenHost: "127.0.0.1"
    port: 17118
    publicBaseUrl: "https://online.fantasyfinal.net"
    allowInsecurePublicHttp: false
    sessionIdleMinutes: 30
    sessionAbsoluteMinutes: 480
    ownerBootstrapPasswordHash: "replace-with-existing-owner-password-hash"
  coreApi:
    enabled: true
    listenHost: "127.0.0.1"
    port: 17200
    serviceToken: "replace-with-shared-core-service-token"
